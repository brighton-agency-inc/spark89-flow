{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.spark89.local/contracts/v1/flow-document.schema.json",
  "title": "Forge flow document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "document_id", "revision", "title", "lifecycle", "created_at", "updated_at", "provenance", "nodes", "connections", "lanes", "layout"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_version": { "const": "1.0.0" },
    "document_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": { "state": { "enum": ["active", "archived"] }, "archived_at": { "$ref": "common.schema.json#/$defs/timestamp" } },
      "allOf": [{ "if": { "properties": { "state": { "const": "archived" } }, "required": ["state"] }, "then": { "required": ["archived_at"] }, "else": { "not": { "required": ["archived_at"] } } }]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["operation", "producer"],
      "properties": {
        "operation": { "enum": ["create-flow-document", "apply-flow-change", "import-flow-document"] },
        "producer": { "$ref": "common.schema.json#/$defs/identifier" },
        "provider": { "$ref": "common.schema.json#/$defs/identifier" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["node_id", "kind", "label"],
        "properties": {
          "node_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "kind": { "enum": ["start", "end", "action", "decision", "approval", "document", "system"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": { "type": "string", "maxLength": 4000 },
          "lane_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "role": { "type": "string", "minLength": 1, "maxLength": 200 },
          "system": { "type": "string", "minLength": 1, "maxLength": 200 },
          "inputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "uniqueItems": true },
          "outputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "uniqueItems": true }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["connection_id", "from_node", "to_node"],
        "properties": {
          "connection_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "from_node": { "$ref": "common.schema.json#/$defs/identifier" },
          "to_node": { "$ref": "common.schema.json#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "condition": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["lane_id", "label"], "properties": { "lane_id": { "$ref": "common.schema.json#/$defs/identifier" }, "label": { "type": "string", "minLength": 1, "maxLength": 200 } } }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["direction"],
      "properties": {
        "direction": { "enum": ["top-down", "left-right"] },
        "nodes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["node_id", "x", "y"], "properties": { "node_id": { "$ref": "common.schema.json#/$defs/identifier" }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } } }
      }
    }
  }
}

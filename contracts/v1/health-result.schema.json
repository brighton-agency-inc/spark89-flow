{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.spark89.local/contracts/v1/health-result.schema.json",
  "title": "Forge module health result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "module_id", "module_version", "checked_at", "status", "checks", "errors"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_version": { "$ref": "common.schema.json#/$defs/semver" },
    "module_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_version": { "$ref": "common.schema.json#/$defs/semver" },
    "checked_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["healthy", "degraded", "unhealthy", "incompatible"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "message"],
        "properties": {
          "check_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "status": { "enum": ["passed", "warned", "failed", "skipped"] },
          "message": { "type": "string", "minLength": 1 },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "errors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/error" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "healthy" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "errors": { "maxItems": 0 },
          "checks": {
            "not": {
              "contains": {
                "properties": { "status": { "const": "failed" } },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  ]
}

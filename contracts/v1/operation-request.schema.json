{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.spark89.local/contracts/v1/operation-request.schema.json",
  "title": "Forge operation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "request_id", "module_id", "module_version", "operation_id", "created_at", "inputs", "grants", "limits"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_version": { "$ref": "common.schema.json#/$defs/semver" },
    "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "module_version": { "$ref": "common.schema.json#/$defs/semver" },
    "operation_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "inputs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifact" } },
    "parameters": { "type": "object" },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_paths", "write_paths", "network_hosts"],
      "properties": {
        "read_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "write_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "network_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_bytes"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_memory_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
